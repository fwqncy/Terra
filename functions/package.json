{
  "name": "terra-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless side of Terra: offline settlement, telemetry ingest and the daily dispatch.",
  "type": "module",
  "main": "src/functions/*.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "prestart": "npm run sync-engine",
    "start": "func start",
    "test": "npm run sync-engine && node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@azure/functions": "4.16.5",
    "mongodb": "6.12.0"
  }
}
